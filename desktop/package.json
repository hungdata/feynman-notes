{
  "name": "feynman-notes-desktop",
  "version": "1.0.0",
  "description": "Feynman Notes desktop client for macOS",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg zip",
    "build:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "build:mac:x64": "electron-builder --mac dmg zip --x64"
  },
  "author": "Dương Tấn Hưng",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.feynmannotes.desktop",
    "productName": "Feynman Notes",
    "artifactName": "Feynman-Notes-${version}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "sign": false
    }
  }
}

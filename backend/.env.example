MONGODB_CONNECTION_STRING=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
PORT=5051
NODE_ENV=development
# Comma-separated frontend origins when frontend and backend use different domains.
ALLOWED_ORIGINS=
# Public backend URL. Register the callback URLs below in Google/Meta consoles:
# http://localhost:5051/api/auth/google/callback
# http://localhost:5051/api/auth/facebook/callback
APP_BASE_URL=http://localhost:5051
FRONTEND_URL=http://localhost:5173
AUTH_SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# AI Teacher (server-side only; never expose these values to the frontend)
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_MAX_OUTPUT_TOKENS=700
AI_REQUEST_TIMEOUT_MS=30000
AI_RATE_LIMIT_PER_MINUTE=10

# ─────────────────────────────────────────────────────────────────────────────
# Feynman Notes — cấu hình backend (TẤT CẢ đều không bắt buộc khi chạy trên máy)
#
# Không có file .env?  `npm run dev` vẫn chạy:
#   • dữ liệu lưu bằng tệp JSON trong backend/data
#   • tự tạo AUTH_SESSION_SECRET cho môi trường dev
#   • "chế độ local": mở http://localhost:5173 là dùng ngay, không cần đăng nhập
# Chỉ copy file này thành backend/.env khi muốn bật MongoDB, Google, AI…
# ─────────────────────────────────────────────────────────────────────────────

PORT=5051
# NODE_ENV=production

# ── Lưu trữ ──────────────────────────────────────────────────────────────────
# Có chuỗi kết nối → dùng MongoDB. Bỏ trống → lưu file trong DATA_DIR.
MONGODB_CONNECTION_STRING=
# STORAGE=auto            # auto | mongo | file
# DATA_DIR=./data         # thư mục lưu file (mặc định backend/data)

# ── Đăng nhập ────────────────────────────────────────────────────────────────
# LOCAL_MODE=auto         # auto | on | off — tự đăng nhập khi mở trên chính máy chạy server
# Bắt buộc ở production (chuỗi ngẫu nhiên ≥ 32 ký tự). Dev: tự sinh nếu bỏ trống.
AUTH_SESSION_SECRET=
# Địa chỉ public của backend (không có dấu / ở cuối). Callback Google:
#   {APP_BASE_URL}/api/auth/google/callback
APP_BASE_URL=http://localhost:5051
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Danh sách origin frontend (phân cách bằng dấu phẩy) khi frontend/backend khác domain.
ALLOWED_ORIGINS=

# ── AI (chỉ ở server, không bao giờ đưa lên frontend) ───────────────────────
# Cách 1 — API chuẩn OpenAI (proxy trên máy, OpenAI, OpenRouter, Gemini…).
# Dùng cho AI Teacher và tính năng "Sách PDF → lộ trình học".
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Cách 2 — Cloudflare Workers AI (chỉ AI Teacher). Đặt AI_PROVIDER=cloudflare để ép dùng.
# AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_MS=120000
AI_RATE_LIMIT_PER_MINUTE=10
# Số chương AI xử lý song song khi tạo lộ trình từ sách.
COURSE_AI_CONCURRENCY=2

# ── Web RAG cho AI Teacher (tùy chọn) ────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_RESULT_COUNT=3
BRAVE_SEARCH_TIMEOUT_MS=8000
BRAVE_SEARCH_CACHE_TTL_MS=21600000
